<script>
function setName(){
let n=prompt("Wie heißt du?");
if(n){
localStorage.setItem("name",n);
document.querySelector(".greeting").innerHTML="👋 Hallo "+n+"!";
}
}
window.onload=()=>{
let n=localStorage.getItem("name");
if(n) document.querySelector(".greeting").innerHTML="👋 Hallo "+n+"!";
}

function toggleTheme(){
document.body.classList.toggle("light");
}

let sec=14399;
setInterval(()=>{
sec--;
let h=Math.floor(sec/3600);
let m=Math.floor((sec%3600)/60);
let s=sec%60;
document.getElementById("timer").innerHTML=
"⏰ Angebot endet in "+
String(h).padStart(2,"0")+":"+
String(m).padStart(2,"0")+":"+
String(s).padStart(2,"0");
},1000);

const buyers=[
"Thomas aus Berlin",
"Markus aus Hamburg",
"Lena aus Köln",
"Peter aus München",
"Alex aus Stuttgart"
];

setInterval(()=>{
let r=buyers[Math.floor(Math.random()*buyers.length)];
document.getElementById("salePopup").innerHTML="🔥 "+r+" hat gekauft";
},7000);
